<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nabom_market.product.ProductMapper">

    <sql id="columns">
        id, name, price, stock, created_at, updated_at
    </sql>

    <sql id="searchWhere">
        <where>
            <if test="keyword != null"> AND name LIKE #{keywordPattern} ESCAPE '!' </if>
            <if test="minPrice != null"> AND price &gt;= #{minPrice} </if>
            <if test="maxPrice != null"> AND price &lt;= #{maxPrice} </if>
            <if test="inStock"> AND stock &gt; 0 </if>
        </where>
    </sql>

    <select id="findById" resultType="Product">
        SELECT <include refid="columns" />
        FROM product
        WHERE id = #{id}
    </select>

    <select id="search" resultType="Product">
        SELECT <include refid="columns" />
        FROM product
        <include refid="searchWhere" />
        <choose>
            <when test="sort == 'price_asc'">  ORDER BY price ASC, id DESC  </when>
            <when test="sort == 'price_desc'"> ORDER BY price DESC, id DESC </when>
            <otherwise>                        ORDER BY created_at DESC, id DESC </otherwise>
        </choose>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countBySearch" resultType="long">
        SELECT count(*)
        FROM product
        <include refid="searchWhere" />
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product (name, price, stock)
        VALUES (#{name}, #{price}, #{stock})
    </insert>

    <update id="update">
        UPDATE product
        SET name = #{name},
            price = #{price},
            stock = #{stock}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM product WHERE id = #{id}
    </delete>

    <select id="existsById">
        SELECT EXISTS (
            SELECT 1
            FROM product
            WHERE id = #{id}
        )
    </select>

    <update id="deductStock">
        UPDATE product
        SET stock = stock - #{quantity}
        WHERE id = #{productId} AND stock >= #{quantity}
    </update>

    <update id="restoreStock">
        UPDATE product
        SET stock = stock + #{quantity}
        WHERE id = #{productId}
    </update>

</mapper>
