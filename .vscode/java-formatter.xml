<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  nabom-market Java 포매터 프로필.
  여기 없는 항목은 Eclipse 기본값을 따른다.
-->
<profiles version="21">
  <profile kind="CodeFormatterProfile" name="nabom" version="21">
    <!-- 들여쓰기: 스페이스 4칸 -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="2"/>
    <setting id="org.eclipse.jdt.core.formatter.use_tabs_only_for_leading_indentations" value="false"/>

    <!-- 줄 길이 -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="120"/>

    <!-- 이미 적절히 나눠 쓴 줄을 다시 한 줄로 합치지 않는다 -->
    <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.join_lines_in_comments" value="false"/>

    <!-- 의도적으로 넣은 빈 줄 1개는 보존 -->
    <setting id="org.eclipse.jdt.core.formatter.number_of_empty_lines_to_preserve" value="1"/>

    <!-- 애너테이션은 항상 줄바꿈 (필드 애너테이션 제외) -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_after_annotation_on_type" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_after_annotation_on_method" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_after_annotation_on_field" value="insert"/>

    <!-- switch 문 case 들여쓰기 -->
    <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_switch" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_cases" value="true"/>

    <!-- record 컴포넌트는 항상 한 줄에 하나씩.
         49 = one-per-line(48) + force(1). 짧은 record까지 줄바꿈되는 게 싫으면 48로 낮춘다. -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_record_components" value="49"/>

    <!-- @formatter:off / @formatter:on 주석으로 포매팅을 부분적으로 끌 수 있게 한다 -->
    <setting id="org.eclipse.jdt.core.formatter.use_on_off_tags" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.disabling_tag" value="@formatter:off"/>
    <setting id="org.eclipse.jdt.core.formatter.enabling_tag" value="@formatter:on"/>
  </profile>
</profiles>
